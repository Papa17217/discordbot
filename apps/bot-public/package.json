{
  "name": "@discord-saas/bot-public",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:prod": "node dist/index.js",
    "lint": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "deploy-commands": "tsx src/utils/deployCommands.ts"
  },
  "dependencies": {
    "discord.js": "^14.16.0",
    "@prisma/client": "^6.2.0",
    "ioredis": "^5.4.0",
    "express": "^4.21.0",
    "winston": "^3.17.0",
    "zod": "^3.23.0",
    "@discord-saas/types": "workspace:*",
    "@discord-saas/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
