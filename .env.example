# ============================================
# DISCORD SAAS — Environment Variables
# ============================================
# Skopiuj ten plik jako .env i uzupełnij wartości

# ── Database (Neon PostgreSQL) ──────────────
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# ── Redis (Upstash) ────────────────────────
REDIS_URL="rediss://:password@endpoint.upstash.io:6379"

# ── Discord Bot ────────────────────────────
DISCORD_TOKEN="your-bot-token-here"
DISCORD_CLIENT_ID="your-client-id"
DISCORD_CLIENT_SECRET="your-client-secret"
DISCORD_BOT_PERMISSIONS="8"
DISCORD_CALLBACK_URL="http://localhost:3000/api/auth/callback"

# ── JWT Auth ───────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ── API ────────────────────────────────────
API_PORT=4000
API_URL="http://localhost:4000"
NODE_ENV="development"

# ── Frontend ───────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# ── Bot Internal API ──────────────────────
BOT_API_PORT=4001
BOT_API_SECRET="internal-bot-api-secret"

# ── Opcjonalne ─────────────────────────────
# OPENAI_API_KEY="sk-..."
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
